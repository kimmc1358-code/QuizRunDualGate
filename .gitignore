# Godot 4+ specific ignores
.godot/
/android/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.vscode/
.idea/
*.tmp
# Claude Code's per-clone working state (scratch worktrees, task locks).
# CLAUDE.md is the part meant to be shared, and it sits at the repo root.
.claude/

# Flag generation pipeline — source library and intermediate sizes.
# Only assets/flags/256x171 is loaded by the game (see flags_data.json);
# the rest are regenerable intermediates, kept on disk but out of git.
/flag-icons/
/assets/flags/64x64/
/assets/flags/128x128/
/assets/flags/256x256/

# Scratch images from art-alignment debugging
**/_dbg_*.png
**/_dbg_*.png.import

# Windows/OneDrive folder metadata
desktop.ini

# Uncompressed music masters — the game ships the OGG encoded from these.
# See assets/audio/_masters/README.md.
/assets/audio/_masters/
