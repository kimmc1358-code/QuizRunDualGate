; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="QuizRunDualGate"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Godot 4 는 이 값을 정수 enum 으로 받는다
; (0=Landscape, 1=Portrait, ...). Godot 3 시절의 "portrait" 문자열이
; 남아 있으면 타입이 맞지 않아 조용히 무시되고 0=가로로 떨어진다 —
; 데스크톱에서는 창 크기가 세로라 티가 안 나고, 안드로이드에서만 드러난다.
window/handheld/orientation=1

; 에디터에서 F5 로 실행할 때만 20:9 창으로 띄운다. 기준 해상도(위의
; viewport_width/height)는 16:9 그대로다 — 게이트 판의 상한이 거기서 나오므로
; (_gate_field_height_cap) 이 값을 건드리면 난이도가 같이 움직인다. 여기서
; 바꾸는 것은 "테스트할 때 어떤 기기처럼 보이나"뿐이다.
;
; 요즘 안드로이드 주력이 1080x2400 = 20:9 라, 데스크톱에서 16:9 로 보면서
; 개발하면 실제 대부분의 사용자가 보는 화면을 한 번도 안 보게 된다.
;
; ".editor" 접미사가 붙으면 editor 기능 태그가 있을 때만 적용된다. 익스포트된
; APK 는 template 빌드라 그 태그가 없으므로 0(=미적용)으로 떨어지고, 기기
; 화면을 그대로 쓴다. 같은 방식이 아래 rendering_device/driver.windows 에도
; 이미 쓰이고 있다.
window/size/window_width_override.editor=480
window/size/window_height_override.editor=1067

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Android 내보내기가 요구한다. 이 프로젝트의 텍스처는 473개 전부 무손실
; (compress/mode=0)이라 실제로 ETC2/ASTC 로 재인코딩되는 그림은 없다 —
; VRAM 압축을 쓰는 파일이 생기면 그때부터 이 설정이 실제로 일한다.
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
