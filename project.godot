; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="QuizRunDualGate"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=480
window/size/viewport_height=854
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Godot 4 는 이 값을 정수 enum 으로 받는다
; (0=Landscape, 1=Portrait, ...). Godot 3 시절의 "portrait" 문자열이
; 남아 있으면 타입이 맞지 않아 조용히 무시되고 0=가로로 떨어진다 —
; 데스크톱에서는 창 크기가 세로라 티가 안 나고, 안드로이드에서만 드러난다.
window/handheld/orientation=1

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

; Android 내보내기가 요구한다. 이 프로젝트의 텍스처는 473개 전부 무손실
; (compress/mode=0)이라 실제로 ETC2/ASTC 로 재인코딩되는 그림은 없다 —
; VRAM 압축을 쓰는 파일이 생기면 그때부터 이 설정이 실제로 일한다.
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
