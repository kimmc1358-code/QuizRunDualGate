class_name ScoreFormat
extends RefCounted

## 점수를 글자로 바꾸는 두 가지 방식. 어느 쪽을 쓸지는 자리가 정한다.
##
## 좁은 자리 — HUD 상단의 SCORE/BEST 숫자, 모드 선택 카드의 BEST 판 — 는
## 그려 넣을 칸이 정해져 있고 그 칸이 딱 다섯 글자다. compact() 는 어떤 값이
## 들어와도 다섯 글자를 넘기지 않는다는 것이 유일한 계약이고,
## tools/check_score_format.gd 가 int32 전 구간에서 그걸 확인한다.
##
## 넓은 자리 — 게임오버 팝업 — 는 이걸 쓰지 않는다. 거기는 PopupBase._group()
## 으로 콤마 넣은 전체 숫자를 그대로 보여준다("1,250"). 줄여 쓰는 것은 자리가
## 없을 때의 타협이지 더 나은 표기가 아니므로, 자리가 있으면 안 줄인다.

## 다섯 글자 안에 들어가는 표기.
##
##   0 ~ 99,999          그대로. 앞자리 0 을 채우지 않는다 — "00085" 는 다섯
##                       칸을 쓰지만 읽는 사람에게 주는 정보가 "85" 와 같고,
##                       기록이 없는 카드가 "00000" 으로 요란해진다.
##   100,000 ~ 999,999   K, 소수점 없이            "123K"
##   1,000,000 ~         M, 소수점 한 자리         "1.2M"
##
## 위쪽 두 갈래(100M 이상은 M 정수, 10억 이상은 B)는 이 게임에서 도달할 수
## 있는 점수가 아니지만, best_scores 가 PackedInt32Array 라 int32 최대값까지는
## 들어올 수 있고 계약이 "절대 다섯 글자를 안 넘는다" 이므로 끝까지 덮는다.
##
## 자를 때는 반올림이 아니라 버림이다. 반올림하면 999,999 가 "1000K" 가 되어
## 다섯 글자를 넘기고, 아직 100만이 아닌 점수를 100만이라고 말하게 된다.
static func compact(value: int) -> String:
	var sign_text := "-" if value < 0 else ""
	var a: int = absi(value)
	if a < 100000:
		return sign_text + str(a)
	if a < 1000000:
		return sign_text + "%dK" % (a / 1000)
	if a < 100000000:
		return sign_text + "%d.%dM" % [a / 1000000, (a % 1000000) / 100000]
	if a < 1000000000:
		return sign_text + "%dM" % (a / 1000000)
	return sign_text + "%d.%dB" % [a / 1000000000, (a % 1000000000) / 100000000]
